<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- PackageManager ищет пакеты для ручного запуска, в том числе без иконки в лаунчере. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Виброотклик при перехвате двойного нажатия -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Для пресета «Фонарик»: управление вспышкой камеры -->
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <!-- Определение активного VPN (TRANSPORT_VPN) — публичный API -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Метаданные Vivo на уровне <application>: их проверяет системный сервис при двойном нажатии кнопки питания -->
        <meta-data
            android:name="com.vivo.wallet.support.typeswing"
            android:value="true" />
        <meta-data
            android:name="com.vivo.wallet.nfc.SupportDoubleClick"
            android:value="true" />
        <meta-data
            android:name="com.vivo.wallet.nfc.CommonSupportDoubleClick"
            android:value="true" />
        <meta-data
            android:name="com.vivo.wallet.nfc.supportVersion"
            android:value="2" />
        <meta-data
            android:name="com.vivo.pay.nfc.supportVersion"
            android:value="1" />

        <!-- Получение binder Shizuku для privileged-вызовов от ADB shell UID -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Главное окно настроек в стиле Material You -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activity-перехватчик двойного нажатия кнопки питания Vivo (NFC_BUS_SWINGSPLASH) -->
        <activity
            android:name=".SwipeEntryActivity"
            android:exported="true"
            android:label="@string/swipe_activity_label"
            android:theme="@style/TransparentSwipeTheme"
            android:taskAffinity="com.vivotomirpay.stub.swipe"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTask"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density">

            <!-- Те же метаданные Vivo дублируются внутри самой Activity-обработчика:
                 некоторые сборки OriginOS/FuntouchOS ищут com.vivo.wallet.* именно на самом
                 компоненте-обработчике интента NFC_BUS_SWINGSPLASH. -->
            <meta-data
                android:name="com.vivo.wallet.support.typeswing"
                android:value="true" />
            <meta-data
                android:name="com.vivo.wallet.nfc.SupportDoubleClick"
                android:value="true" />
            <meta-data
                android:name="com.vivo.wallet.nfc.CommonSupportDoubleClick"
                android:value="true" />
            <meta-data
                android:name="com.vivo.wallet.nfc.supportVersion"
                android:value="2" />
            <meta-data
                android:name="com.vivo.pay.nfc.supportVersion"
                android:value="1" />

            <intent-filter>
                <action android:name="vivo.intent.action.NFC_BUS_SWINGSPLASH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Настраиваемое меню действий (special:menu).
             showWhenLocked/turnScreenOn задаются в коде; тема — полупрозрачная. -->
        <activity
            android:name=".MenuActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.vivotomirpay.stub.menu"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:theme="@style/MenuTheme" />

    </application>

</manifest>
